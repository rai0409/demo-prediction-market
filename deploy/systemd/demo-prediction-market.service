[Unit]
Description=Demo Prediction Market web application
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=rai
Group=rai
WorkingDirectory=/home/rai/demo-prediction-market
EnvironmentFile=/home/rai/demo-prediction-market/.env
Environment=PYTHONUNBUFFERED=1
Environment=DEMO_PREDICTION_LIVE=0
ExecStart=/home/rai/demo-prediction-market/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8093
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
KillMode=mixed
StandardOutput=journal
StandardError=journal
SyslogIdentifier=demo-prediction-market
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
UMask=0077
ReadWritePaths=/home/rai/demo-prediction-market/data
ReadWritePaths=/home/rai/demo-prediction-market/runtime

[Install]
WantedBy=multi-user.target

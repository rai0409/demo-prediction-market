[Unit]
Description=Demo Prediction Market one-shot market synchronization
After=network.target

[Service]
Type=oneshot
User=rai
Group=rai
WorkingDirectory=/home/rai/demo-prediction-market
EnvironmentFile=/home/rai/demo-prediction-market/.env
Environment=PYTHONUNBUFFERED=1
Environment=DEMO_PREDICTION_LIVE=0
ExecStart=/home/rai/demo-prediction-market/.venv/bin/python /home/rai/demo-prediction-market/scripts/sync_polymarket_markets.py --json
TimeoutStartSec=120
StandardOutput=journal
StandardError=journal
SyslogIdentifier=demo-prediction-market-sync
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
UMask=0077
ReadWritePaths=/home/rai/demo-prediction-market/data
